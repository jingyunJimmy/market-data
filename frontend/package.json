{
  "name": "market-data-dashboard",
  "version": "0.1.0",
  "description": "Angular dashboard for the futures market-data analytics and quality API.",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --coverage",
    "lint": "prettier --check \"src/**/*.{ts,html,css}\"",
    "format": "prettier --write \"src/**/*.{ts,html,css}\""
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "lightweight-charts": "^5.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
