# Copy to .env and adjust. All settings are optional -- every one shown here is
# already the default. Relative paths resolve against the working directory,
# so run the scripts and the API from backend/.

MARKET_DATA_DB_PATH=data/market_data.duckdb
MARKET_DATA_VWAP_WINDOW_MINUTES=15
MARKET_DATA_SOURCE_MINUTE_TZ=America/Chicago
MARKET_DATA_DAILY_BAR_TZ=America/Chicago

# Data quality tuning
MARKET_DATA_OUTLIER_MAD_THRESHOLD=8.0
MARKET_DATA_VOLUME_SPIKE_THRESHOLD=20.0
MARKET_DATA_GAP_MIN_MULTIPLE=1.5

# Intelligent insights, read by Claude through LangChain.
MARKET_DATA_INSIGHTS_MAX_OCCURRENCES=50000
MARKET_DATA_LLM_TIMEOUT_S=180

# MARKET_DATA_LLM_MODEL defaults to claude-sonnet-5.
MARKET_DATA_LLM_MODEL=claude-sonnet-5
MARKET_DATA_LLM_MAX_TOKENS=16000
# Falls back to the ANTHROPIC_API_KEY environment variable when unset.
MARKET_DATA_LLM_API_KEY=sk-ant-***
